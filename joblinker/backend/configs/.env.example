# JobLinker Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database (PostgreSQL 17)
DB_HOST=localhost
DB_PORT=5432
DB_USER=joblinker
DB_PASSWORD=joblinker_dev_password
DB_NAME=joblinker
DB_SSLMODE=disable

# Redis (7.4+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Chroma (0.6+)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# AI Model Configuration
AI_API_KEY=your-api-key
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
